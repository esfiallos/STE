// Cloudflare Workers con archivos estáticos (sin script): sirve dist/ tal cual. Lo publica GitHub Actions
// (.github/workflows/publicar.yml) con wrangler. Detalle en docs/ENTORNOS_Y_DESPLIEGUE.md.
//   · producción (rama main, base PROD):        wrangler deploy             → panel-noc
//   · desarrollo (rama desarrollo, base DEV):   wrangler deploy --env dev   → panel-noc-dev
// APAGADO (27/11/2026): "workers_dev": false quita la dirección *.workers.dev. Publicar con esto deja el worker sin
// dirección (inaccesible). Para volver a encenderlo, poner true en ambos y relanzar los workflows a mano.
{
  "name": "panel-noc",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Sin URLs de vista previa por versión: cada entorno tiene la suya fija
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // dist/404.html con estado 404 para rutas que no existen
    "not_found_handling": "404-page",
    // /login → /login/ (como las rutas de RUTAS)
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "dev": {
      "name": "panel-noc-dev",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash"
      }
    }
  }
}
