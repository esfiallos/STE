---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import TabNav from '../components/layout/TabNav.astro';
import BoardToolbar from '../components/board/BoardToolbar.astro';
import MetricBar from '../components/metrics/MetricBar.astro';
import IncidentBoard from '../components/board/IncidentBoard.astro';
import HistoryView from '../components/history/HistoryView.astro';
import PlanningView from '../components/planning/PlanningView.astro';
import FollowUpView from '../components/followUp/FollowUpView.astro';
import HandoverView from '../components/handover/HandoverView.astro';
import MyHandoversView from '../components/handover/MyHandoversView.astro';
import NoProfileNotice from '../components/auth/NoProfileNotice.astro';
import AuditView from '../components/audit/AuditView.astro';
import CoordinatorPanel from '../components/coordination/CoordinatorPanel.astro';
import CaseSearchView from '../components/caseSearch/CaseSearchView.astro';
import AssignIncidentModal from '../components/modals/AssignIncidentModal.astro';
import EditIncidentModal from '../components/modals/EditIncidentModal.astro';
import LunchModal from '../components/modals/LunchModal.astro';
import TechniciansModal from '../components/modals/TechniciansModal.astro';
import ToastHost from '../components/ui/ToastHost.astro';
---

<Layout title="Panel de Traspasos & Turnos NOC">
  <!-- Oculto hasta que main.ts confirma que hay sesión iniciada -->
  <div id="appRoot" class="noc-app hidden">
    <Header />
    <TabNav />

    <main class="noc-main-content">
      <section data-vista="panel" class="view hidden">
        <CoordinatorPanel />
      </section>

      <section data-vista="tablero" class="view">
        <BoardToolbar />
        <MetricBar />
        <IncidentBoard />
      </section>

      <section data-vista="busqueda" class="view hidden">
        <CaseSearchView />
      </section>

      <section data-vista="seguimiento" class="view hidden">
        <FollowUpView />
      </section>

      <section data-vista="traspaso" class="view hidden">
        <HandoverView />
      </section>

      <section data-vista="misTraspasos" class="view hidden">
        <MyHandoversView />
      </section>

      <section data-vista="planificacion" class="view hidden">
        <PlanningView />
      </section>

      <section data-vista="historial" class="view hidden">
        <HistoryView />
      </section>

      <section data-vista="bitacora" class="view hidden">
        <AuditView />
      </section>
    </main>

    <AssignIncidentModal />
    <EditIncidentModal />
    <LunchModal />
    <TechniciansModal />
  </div>

  <NoProfileNotice />
  <ToastHost />
</Layout>

<script>
  import '../scripts/main';
</script>
