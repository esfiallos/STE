---
import '@fontsource-variable/inter';
import '../styles/main.scss';
import { politicaParaMeta } from '../config/seguridad';

interface Props {
  title: string;
}

const { title } = Astro.props;
const esDesarrollo = import.meta.env.PUBLIC_APP_ENV === 'development';

// Política de contenido (D35), la misma que las cabeceras HTTP de Cloudflare (config/seguridad.ts). En `astro dev`
// no se aplica: Vite inyecta scripts en línea para recargar en caliente. Sí se aplica en la compilación de DEV
// publicada. frame-ancestors (anti-clickjacking) solo funciona por cabecera: va en dist/_headers.
const politicaDeContenido = import.meta.env.DEV ? null : politicaParaMeta(import.meta.env.PUBLIC_SUPABASE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    {politicaDeContenido && <meta http-equiv="Content-Security-Policy" content={politicaDeContenido} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{esDesarrollo ? `[DEV] ${title}` : title}</title>
    <!-- FontAwesome para iconos (integrity: si el CDN sirviera otro archivo, el navegador no lo carga) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
