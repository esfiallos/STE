---
import Modal from './Modal.astro';
---

<Modal id="modalNewIncident" titulo="Nuevo incidente">
  <form id="formNewIncident" class="noc-form">
    <div class="form-group">
      <label for="inputIncNumber">Número de incidente</label>
      <input type="text" id="inputIncNumber" placeholder="Ej: INC009842" autocomplete="off" required />
    </div>
    <div class="form-group">
      <label for="selectTechnician">Técnico</label>
      <select id="selectTechnician" required></select>
      <span class="form-hint">técnicos disponibles · o usa <strong>Asignar a la ronda</strong> para el siguiente en orden alfabético</span>
      <span class="form-hint round-hint" id="roundHint" aria-live="polite"></span>
    </div>
    <div class="form-group">
      <label for="inputIncNote">Nota</label>
      <input type="text" id="inputIncNote" placeholder="Ej: ACME · ID de enlace 4410" autocomplete="off" />
    </div>

    <p id="incidentError" class="form-error hidden" role="alert"></p>

    <div class="modal-actions">
      <button type="button" class="btn" data-close-modal>Cancelar</button>
      <button type="button" id="btnAssignRound" class="btn">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Asignar a la ronda
      </button>
      <button type="submit" id="btnSubmitIncident" class="btn btn-primary">Asignar al técnico</button>
    </div>
  </form>
</Modal>
