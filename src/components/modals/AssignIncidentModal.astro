---
import Modal from './Modal.astro';
---

<Modal id="modalNewIncident" titulo="Nuevo incidente">
  <form id="formNewIncident" class="noc-form">
    <div class="form-group">
      <label for="inputIncNumber">Número de incidente</label>
      <input type="text" id="inputIncNumber" placeholder="Ej: INC009842" autocomplete="off" required />
    </div>
    <div class="form-group">
      <label for="selectTechnician">Técnico</label>
      <select id="selectTechnician" required></select>
      <span class="form-hint">técnicos disponibles</span>
    </div>
    <div class="form-group">
      <label for="inputIncNote">Comentario</label>
      <input type="text" id="inputIncNote" placeholder="Ej: P2 - Monitoreo enlace fibra" autocomplete="off" />
    </div>

    <p id="incidentError" class="form-error hidden" role="alert"></p>

    <div class="modal-actions">
      <button type="button" class="btn" data-close-modal>Cancelar</button>
      <button type="submit" id="btnSubmitIncident" class="btn btn-primary">Asignar</button>
    </div>
  </form>
</Modal>
