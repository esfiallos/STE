---
// "Traspaso" del técnico: armar la entrega de fin de turno y cerrar turno. Lo dibuja scripts/handover/handoverView.ts
import { LARGO_MAXIMO_DESCRIPCION, LARGO_MAXIMO_ETIQUETA } from '../../domain/followUp';
import { ESTADOS_DE_SEGUIMIENTO } from '../../domain/followUp';
import { ETIQUETA_ESTADO_CASO } from '../../domain/handover';
---

<section class="panel-card handover" id="handoverView" aria-labelledby="handoverTitle">
  <div class="followup-toolbar">
    <div>
      <h2 id="handoverTitle" class="planning-title">Traspaso de fin de turno</h2>
      <p id="handoverSummary" class="planning-help"></p>
    </div>
    <span id="handoverSaveState" class="handover-save" role="status" aria-live="polite"></span>
  </div>

  <p id="handoverStatus" class="board-status hidden" role="status"></p>

  <div id="handoverBody" class="hidden">
    <div class="handover-receivers">
      <h3 class="followup-section__title"><i class="fa-solid fa-users" aria-hidden="true"></i> Pueden recibir <small>(marca quién entra al reparto)</small></h3>
      <div id="handoverReceivers" class="handover-receivers__list"></div>
    </div>

    <div class="handover-actions">
      <button id="btnRepartirPendientes" type="button" class="btn btn-sm" title="Reparte solo los casos sin receptor">
        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Repartir sin receptor
      </button>
      <button id="btnRebalancear" type="button" class="btn btn-sm" title="Reequilibra todo lo que no tenga candado">
        <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> Rebalancear todo
      </button>
      <button id="btnDeshacerReparto" type="button" class="btn btn-sm" disabled>
        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Deshacer
      </button>
    </div>

    <div id="handoverFilters"></div>
    <div id="handoverItems" class="handover-items"></div>

    <div class="handover-footer">
      <ul id="handoverProblems" class="handover-problems"></ul>

      <div class="handover-preview">
        <div class="handover-preview__head">
          <h3 class="followup-section__title"><i class="fa-regular fa-eye" aria-hidden="true"></i> Vista previa</h3>
          <label class="handover-inline">
            Ordenar por
            <select id="handoverOrder">
              <option value="tipo">Tipo (INC, SCTASK, Fresh)</option>
              <option value="etiqueta">Etiqueta</option>
              <option value="empresa">Empresa</option>
            </select>
          </label>
          <label class="handover-inline">
            <input type="checkbox" id="handoverTags" checked /> Mostrar etiquetas
          </label>
        </div>
        <iframe id="handoverPreview" class="handover-preview__frame" title="Vista previa del correo de traspaso" sandbox=""></iframe>
        <div class="handover-copy">
          <button type="button" class="btn btn-sm" data-copiar="outlook"><i class="fa-regular fa-envelope" aria-hidden="true"></i> Copiar para Outlook</button>
          <button type="button" class="btn btn-sm" data-copiar="texto"><i class="fa-regular fa-file-lines" aria-hidden="true"></i> Copiar texto</button>
          <button type="button" class="btn btn-sm" data-copiar="tsv"><i class="fa-solid fa-table" aria-hidden="true"></i> Copiar para Excel</button>
        </div>
      </div>

      <button id="btnCerrarTurno" type="button" class="btn btn-primary handover-send" disabled>
        <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Cerrar turno y enviar traspaso
      </button>
    </div>
  </div>

  <!-- Un caso del traspaso (lo completa scripts/handover/handoverView.ts) -->
  <template id="tpl-traspaso-item">
    <article class="handover-item" data-ref="item">
      <header class="followup-card__head">
        <span class="followup-code" data-ref="codigo"></span>
        <span class="handover-item__meta" data-ref="meta"></span>
        <label class="handover-lock" title="Con candado, el reparto automático no lo mueve">
          <input type="checkbox" data-campo="candado" /> <i class="fa-solid fa-lock" aria-hidden="true"></i>
          <span class="sr-only">Candado</span>
        </label>
      </header>
      <div class="handover-item__grid">
        <label class="followup-field">
          <span>Estado</span>
          <select data-campo="estado">
            {ESTADOS_DE_SEGUIMIENTO.map((e) => <option value={e}>{ETIQUETA_ESTADO_CASO[e]}</option>)}
          </select>
        </label>
        <label class="followup-field">
          <span>Entregar a</span>
          <select data-campo="receptor"></select>
        </label>
        <label class="followup-field">
          <span>Etiqueta</span>
          <input type="text" maxlength={LARGO_MAXIMO_ETIQUETA} data-campo="etiqueta" placeholder="Sin etiqueta" />
        </label>
        <label class="followup-field">
          <span>Recordar el día</span>
          <input type="date" data-campo="recordatorioFecha" />
        </label>
        <label class="followup-field">
          <span>Qué recordar</span>
          <input type="text" maxlength="200" data-campo="recordatorioTexto" placeholder="Ej: VM programada 10:00" />
        </label>
        <label class="followup-field handover-item__full">
          <span>Descripción <small>(la que recibe quien sigue; es la misma de tu seguimiento)</small></span>
          <textarea rows="2" maxlength={LARGO_MAXIMO_DESCRIPCION} data-campo="descripcion" placeholder="Obligatoria para entregar el caso: qué pasa, qué falta…"></textarea>
        </label>
      </div>
    </article>
  </template>
</section>
