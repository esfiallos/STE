---
// Plantillas de la columna de un técnico y de su elemento de almuerzo.
// Las completan scripts/board/technicianView.ts y scripts/board/lunchView.ts
---

<template id="tpl-tecnico">
  <article class="tech-column-card" data-ref="tecnico">
    <div class="tech-card-header">
      <div class="tech-user-info">
        <div class="avatar" data-ref="avatar" aria-hidden="true"></div>
        <div>
          <h3 class="tech-name" data-ref="nombre"></h3>
          <span class="tech-case-count" data-ref="conteo"></span>
        </div>
      </div>
      <button
        type="button"
        class="btn-quick-add"
        data-ref="botonAsignar"
        data-action="asignar"
        data-edit-only
        title="Asignar incidente"
        aria-label="Asignar incidente"
      >
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>

    <div class="tech-tags">
      <span class="status-chip" data-ref="estado"></span>
      <span class="schedule-chip" data-ref="horario"></span>
    </div>

    <!-- Asignación rápida: el técnico y el turno ya se conocen, solo falta el número -->
    <form class="inline-add" data-form="asignar" data-ref="formAsignar" data-edit-only autocomplete="off">
      <input type="text" name="codigo" placeholder="Número de INC" aria-label="Número de incidente" required />
      <input type="text" name="empresa" placeholder="Empresa (opcional)" aria-label="Empresa (opcional)" maxlength="120" />
      <div class="inline-add__actions">
        <button type="submit" class="btn btn-primary btn-sm">Asignar</button>
        <button type="button" class="btn btn-sm" data-action="cancelar-asignar">Cancelar</button>
      </div>
    </form>

    <div class="incidents-stack" data-ref="incidentes"></div>
  </article>
</template>

<template id="tpl-almuerzo">
  <div class="lunch-item" data-ref="almuerzo">
    <i class="fa-solid fa-utensils" aria-hidden="true"></i>
    <span class="lunch-text" data-ref="texto"></span>
    <button type="button" class="btn-inc-action" data-ref="botonEditar" data-action="editar-almuerzo" data-edit-only>
      <i class="fa-solid fa-pen"></i>
    </button>
  </div>
</template>
