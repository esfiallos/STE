---
// Campo de contraseña con botón mostrar/ocultar y aviso de Bloq Mayús (lo conecta scripts/auth/authUi.ts).
interface Props {
  id: string;
  etiqueta: string;
  autocomplete: 'current-password' | 'new-password';
  minlength?: number;
}

const { id, etiqueta, autocomplete, minlength } = Astro.props;
---

<div class="form-group">
  <label for={id}>{etiqueta}</label>
  <div class="password-field">
    <input type="password" id={id} autocomplete={autocomplete} minlength={minlength} required />
    <button
      type="button"
      class="password-toggle"
      data-toggle-password={id}
      aria-label="Mostrar contraseña"
      aria-pressed="false"
      title="Mostrar contraseña"
    >
      <i class="fa-regular fa-eye" aria-hidden="true"></i>
    </button>
  </div>
  <p class="form-hint caps-hint hidden" data-caps-hint={id}>
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Bloq Mayús está activado.
  </p>
</div>
