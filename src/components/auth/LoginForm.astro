---
const esDesarrollo = import.meta.env.PUBLIC_APP_ENV === 'development';
---

<section class="login-card">
  <h1>
    Panel de Traspasos
    {esDesarrollo && <span class="env-badge">DESARROLLO</span>}
  </h1>
  <p class="login-subtitle">Inicia sesión para continuar</p>

  <form id="loginForm" class="noc-form">
    <div class="form-group">
      <label for="loginEmail">Correo</label>
      <input type="email" id="loginEmail" autocomplete="username" required />
    </div>
    <div class="form-group">
      <label for="loginPassword">Contraseña</label>
      <input type="password" id="loginPassword" autocomplete="current-password" required />
    </div>

    <p id="loginError" class="form-error hidden" role="alert"></p>

    <button type="submit" id="loginSubmit" class="btn-primary btn-block">Entrar</button>
  </form>
</section>
