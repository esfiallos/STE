---
import { LONGITUD_MINIMA_CONTRASENA } from '../../domain/credentials';
import AuthBrand from './AuthBrand.astro';
import PasswordField from './PasswordField.astro';
---

<section class="login-card" id="resetCard">
  <AuthBrand subtitulo="Crea una contraseña nueva" />

  <p id="resetChecking" class="auth-help auth-panel" role="status">
    <span class="btn-spinner is-visible" aria-hidden="true"></span> Verificando el enlace…
  </p>

  <form id="resetForm" class="noc-form auth-panel hidden" novalidate>
    <p class="auth-help">Cuenta: <strong id="resetEmail"></strong></p>
    <PasswordField
      id="resetPassword"
      etiqueta="Contraseña nueva"
      autocomplete="new-password"
      minlength={LONGITUD_MINIMA_CONTRASENA}
    />
    <PasswordField id="resetConfirm" etiqueta="Repite la contraseña" autocomplete="new-password" />
    <p class="form-hint">Al menos {LONGITUD_MINIMA_CONTRASENA} caracteres, con letras y números.</p>

    <p id="resetError" class="form-error hidden" role="alert"></p>

    <button type="submit" id="resetSubmit" class="btn-primary btn-block">
      <span class="btn-spinner" aria-hidden="true"></span>
      <span data-ref="texto">Guardar contraseña</span>
    </button>
  </form>

  <div id="resetInvalid" class="auth-panel auth-stack hidden">
    <p id="resetInvalidText" class="form-error" role="alert"></p>
    <a id="resetInvalidLink" class="btn-primary btn-block" href="#">Pedir un enlace nuevo</a>
  </div>

  <p id="resetDone" class="form-success auth-panel hidden" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i> Contraseña actualizada. Entrando al panel…
  </p>
</section>
